---
import Layout from '../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const sp = `${base}segundo-parcial/`;
const ramas = [
  { t: 'Teórico', chip: 'U8–U10', g: 'p1', href: `${sp}teorico/`, d: 'Teoría de vectores, recta, plano y cónicas, machete de fórmulas y preguntas para aprender.', l: ['Teoría', 'Machete', 'Aprendizaje', 'Preguntero', 'Machetes por unidad'] },
  { t: 'Práctico', chip: 'Ejercicios', g: 'p2', href: `${sp}practico/`, d: 'Modelos oficiales, parciales tomados, finales de práctica y laboratorio al azar.', l: ['Modelos', 'Parciales tomados', 'Finales U8–U10', 'Laboratorio'] },
];
---
<Layout titulo="2º parcial">
  <section class="hero">
    <p class="eyebrow">AGA · U8 a U10</p>
    <h1>2º parcial</h1>
    <p class="lead">Producto escalar, vectorial y mixto; rectas y planos; cónicas y cuádricas. Elegí qué querés hacer.</p>
  </section>
  <div class="ramas">
    {ramas.map((r) => (
      <section class="tarjeta rama" data-g={r.g} aria-labelledby={`r-${r.t}`}>
        <h2 id={`r-${r.t}`} class="rama-t"><a href={r.href}>{r.t}</a> <span class="chip">{r.chip}</span></h2>
        <p>{r.d}</p>
        <ul class="rama-l">{r.l.map((x) => <li class="chip">{x}</li>)}</ul>
        <a class="btn btn-primario" href={r.href}>Entrar a {r.t}</a>
      </section>
    ))}
  </div>
</Layout>
<style>
  .ramas { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); margin: 1.5rem 0 2rem; }
  .rama { --gc: var(--acento); border-top: 5px solid var(--gc); display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .rama[data-g='p2'] { --gc: var(--u8); }
  .rama-t { margin: 0 0 .2rem; font-size: 1.7rem; }
  .rama-t a { color: var(--texto); text-decoration: none; }
  .rama p { margin: 0 0 .4rem; color: var(--suave); }
  .rama-l { list-style: none; padding: 0; margin: 0 0 .8rem; display: flex; flex-wrap: wrap; }
  .rama .btn { align-self: flex-start; margin-top: auto; }
</style>
