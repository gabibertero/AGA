---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { idsDeEjercicios } from '../../../scripts/ids.js';
const base = import.meta.env.BASE_URL;
const todos = (await getCollection('parciales')).sort((a, b) => a.data.orden - b.data.orden);
const grupos = [
  { titulo: 'Modelos oficiales de la profe', tipos: ['modelo'] },
  { titulo: 'Parciales tomados', tipos: ['práctico', 'teórico'] },
  { titulo: 'Banco extra: finales (solo U8–U10)', tipos: ['final'] },
].map((g) => ({ ...g, items: todos.filter((p) => g.tipos.includes(p.data.tipo)) }));
const sp = `${base}segundo-parcial/`;
const modelos = grupos[0].items;
const bloques = [
  { titulo: 'Práctico', chip: 'Parciales', g: 'p2', links: [
    ...modelos.map((m) => [m.data.titulo, 'Tal cual la profe, con el paso a paso', `${sp}parciales/${m.id}/`]),
    ['Parciales tomados', 'Exámenes reales del curso', '#parciales'],
    ['Finales (U8–U10)', 'Banco extra para practicar', '#finales'],
  ] },
  { titulo: 'Laboratorio', chip: 'Al azar', g: 'p2', links: [['Parciales aleatorios', 'Con el formato de los modelos y su resolución', `${sp}laboratorio/`], ['Cónicas interactivas', 'Generadores por tema', `${sp}laboratorio/`]] },
];
---
<Layout titulo="Práctico · 2º parcial">
  <section class="hero">
    <p class="eyebrow"><a href={sp}>2º parcial</a> · Práctico</p>
    <h1>Práctico</h1>
    <p class="lead">Modelos y parciales resueltos, finales de práctica y el laboratorio de ejercicios al azar. ¿Buscás teoría? Está en el <a href={`${sp}teorico/`}>Teórico</a>.</p>
  </section>

  <div class="accesos">
    {bloques.map((b) => (
      <section class="tarjeta acc" data-g={b.g} aria-labelledby={`b-${b.titulo}`}>
        <h2 id={`b-${b.titulo}`} class="acc-t">{b.titulo} <span class="chip">{b.chip}</span></h2>
        <ul>{b.links.map(([tt, d, h]) => <li><a href={h}><strong>{tt}</strong><span class="suave">{d}</span></a></li>)}</ul>
      </section>
    ))}
  </div>

  {grupos.filter((g) => g.items.length).map((g, i) => {
    const lista = (
      <ul class="lista-ex">
        {g.items.map((p) => (
          <li class="tarjeta">
            <a class="ec-titulo" href={`${base}segundo-parcial/parciales/${p.id}/`}>{p.data.titulo}</a>
            <span class="suave"> · {p.data.unidades.join(', ')}</span>
            <span class="suave" data-progreso data-ids={idsDeEjercicios(p.body).join(',')}></span>
          </li>
        ))}
      </ul>
    );
    const id = ['modelos', 'parciales', 'finales'][i];
    return g.tipos.includes('final')
      ? <details class="grupo-fin" id={id}><summary><h2>{g.titulo} ({g.items.length})</h2></summary>{lista}</details>
      : <><h2 id={id}>{g.titulo}</h2>{lista}</>;
  })}
</Layout>

<style>
  .acc-t { margin: 0 0 .6rem; font-size: 1.3rem; }
  .accesos { margin: 1.5rem 0 2rem; }
  .grupo-fin summary { cursor: pointer; }
  .grupo-fin summary h2 { display: inline; }
</style>
