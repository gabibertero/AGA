---
import { getCollection, render } from 'astro:content';
import { idsDeEjercicios } from '../../../scripts/ids.js';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const todos = (await getCollection('parciales')).sort((a, b) => a.data.orden - b.data.orden);
  return todos.map((entry) => ({ params: { id: entry.id }, props: { entry, todos } }));
}
const { entry, todos } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const d = entry.data;
---
<Layout titulo={d.titulo}>
  <div class="examen-cab tarjeta">
    <h1>{d.titulo}</h1>
    <p class="meta">{d.fecha && `${d.fecha} · `}{d.tipo}{d.tema && ` · Tema ${d.tema}`} · Unidades: {d.unidades.map((u) => <span class="chip chip-u" data-unidad={u}>{u}</span>)}</p>
    <p class="meta">Fuente: {d.fuente} (enunciado p.{d.paginasEnunciado}{d.paginasResolucion ? `, resolución p.${d.paginasResolucion}` : "; sin resolución oficial"})</p>
    <span class="barra" aria-hidden="true" data-barra data-ids={idsDeEjercicios(entry.body).join(',')}></span>
  </div>
  <section class="hoja tarjeta" data-hoja hidden aria-labelledby="hoja-t">
    <h2 id="hoja-t">El parcial tal cual</h2>
    <p class="meta">Solo los enunciados, para hacerlo en papel. Abajo está la resolución paso a paso.</p>
    <div data-hoja-cont></div>
    <p><a class="btn-lab" href={`${base}segundo-parcial/laboratorio/`}>Generar otros parciales con este formato → Laboratorio</a></p>
  </section>
  <details class="otros"><summary>Otros exámenes</summary>
  <ul class="tabs" aria-label="Exámenes">
    {todos.map((t) => (
      <li><a href={`${base}segundo-parcial/parciales/${t.id}/`} aria-current={t.id === entry.id ? 'page' : undefined}>{t.data.titulo}</a></li>
    ))}
  </ul>
  </details>
  <section class="tarjeta examen-panel" data-examen-panel data-examen-id={entry.id} hidden aria-labelledby="ex-t">
    <h2 id="ex-t" tabindex="-1">Modo examen</h2>
    <p class="meta" data-en="reposo"><span data-ex="ultimo"></span> Solo enunciados, con cronómetro; al entregar se revelan las soluciones y te autocorregís.</p>
    <div class="ex-fila">
      <button type="button" data-ex="abrir" data-en="reposo">Modo examen</button>
      <label data-en="listo">Minutos <input type="number" data-ex="minutos" value="120" min="1" max="600" inputmode="numeric" /></label>
      <button type="button" data-ex="empezar" data-en="listo">Empezar</button>
      <output class="ex-reloj" data-ex="reloj" data-en="corriendo" role="timer" aria-label="Tiempo restante"></output>
      <button type="button" data-ex="pausa" data-en="corriendo" aria-pressed="false">Pausar</button>
      <button type="button" data-ex="entregar" data-en="corriendo">Entregar</button>
      <button type="button" data-ex="salir" data-en="listo corriendo entregado">Salir del modo examen</button>
    </div>
    <p class="ex-aviso" data-ex="aviso" role="alert" hidden>Se terminó el tiempo. Podés seguir, pero ya pasó el límite.</p>
    <div data-en="entregado" aria-live="polite">
      <p class="ex-nota">Nota: <strong data-ex="nota"></strong>/100 · Tiempo usado: <span data-ex="usado"></span></p>
      <p class="meta" data-ex="detalle"></p>
      <p class="meta" data-ex="oficial" hidden>Puntajes no oficiales: reparto igual.</p>
    </div>
  </section>
  <div class="examen-grid">
    <nav class="indice" aria-label="Ejercicios del examen" data-indice><p class="indice-t">Ejercicios</p><ol></ol></nav>
    <div class="examen-cont"><Content /></div>
  </div>
</Layout>

<script>
  // Hoja del parcial: copia los enunciados oficiales ya renderizados (sin pistas, estado ni soluciones).
  const sec = document.querySelector('[data-hoja]');
  const cont = sec?.querySelector('[data-hoja-cont]');
  const ejs = [...document.querySelectorAll('[data-ejercicio]')];
  if (sec && cont && ejs.length) {
    const consigna = document.querySelector('[data-consigna]');
    if (consigna) cont.append(consigna.cloneNode(true));
    let escaneo = null;
    ejs.forEach((ej) => {
      const of = ej.querySelector('.capa.oficial');
      if (!of) return;
      const c = of.cloneNode(true);
      c.querySelector('.rotulo')?.remove(); c.querySelector('.cita')?.remove();
      const det = c.querySelector('details');
      if (det) { escaneo ??= det; det.remove(); }
      const box = document.createElement('div');
      box.className = 'hoja-ej';
      const n = document.createElement('span');
      n.className = 'hoja-n'; n.textContent = `${ej.dataset.ejercicio !== undefined ? ej.id.replace('ej-', '') : ''}.`;
      const pts = ej.dataset.puntos;
      if (pts && !/pts/i.test(c.textContent)) { const b = document.createElement('strong'); b.textContent = `(${pts} Pts.) `; c.firstElementChild?.prepend(b); }
      box.append(n, c); cont.append(box);
    });
    if (escaneo) { escaneo.className = 'hoja-escaneo'; cont.append(escaneo); }
    sec.hidden = false;
  }
</script>
<style is:global>
  .otros { margin: 0 0 1rem; }
  .otros > summary { cursor: pointer; font-weight: 600; color: var(--link); min-height: 36px; display: flex; align-items: center; }
  .otros .tabs { margin-top: 8px; }
  .hoja { margin-bottom: 1.5rem; }
  .hoja .hoja-ej { display: flex; gap: 10px; margin: .8rem 0; }
  .hoja .hoja-ej .capa { flex: 1; min-width: 0; margin: 0; overflow-x: auto; position: relative; }
  .hoja .hoja-n { font-weight: 700; }
  .hoja .hoja-escaneo { margin-top: .8rem; }
  .hoja .hoja-escaneo summary { cursor: pointer; font-weight: 600; color: var(--link); min-height: 36px; display: inline-flex; align-items: center; }
  .hoja .hoja-escaneo img { max-width: 100%; height: auto; background: #fff; border: 1px solid var(--borde-fuerte); border-radius: var(--r-s); }
  .btn-lab { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 16px; border-radius: 999px; background: var(--acento); color: var(--sobre-acento); font-weight: 600; text-decoration: none; }
  .btn-lab:focus-visible { outline: 3px solid var(--acento); outline-offset: 2px; }
</style>
