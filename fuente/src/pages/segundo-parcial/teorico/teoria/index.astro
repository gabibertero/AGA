---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
const items = (await getCollection('teorias')).sort((a, b) => a.data.orden - b.data.orden);
---
<Layout titulo="Teoría · 2º parcial">
  <p class="eyebrow"><a href={`${base}segundo-parcial/`}>2º parcial</a> · <a href={`${base}segundo-parcial/teorico/`}>Teórico</a> · Teoría</p>
  <h1>Teoría</h1>
  <p class="lead">Definiciones, cómo se hace cada cosa, todas las formas de ecuación, controles y cómo graficar. Una página por tema.</p>
  <ul class="grilla lista-tarjetas">
    {items.map((i) => (
      <li class="tarjeta tarjeta-u" data-unidad={i.data.unidad}>
        <a class="ec-titulo" href={`${base}segundo-parcial/teorico/teoria/${i.id}/`}><span class="chip chip-u chip-lg" data-unidad={i.data.unidad}>{i.data.unidad}</span> {i.data.titulo}</a>
        <p class="meta">{i.data.resumen}</p>
      </li>
    ))}
  </ul>
  <p class="suave">Cuando termines: el <a href={`${base}segundo-parcial/teorico/machete/`}>machete</a> y el <a href={`${base}segundo-parcial/teorico/aprendizaje/`}>aprendizaje</a>.</p>
</Layout>
